# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (do NOT commit secrets to Git)
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*

# leftover nested project (not needed)
/barbershop-app

# vercel & netlify
.vercel
.netlify
